// # oofold Root Anchor Subsystem
//
// Logline: Top-level anchor consolidating core, render, and ipc subsystems for oofold.
//
// Setup: Pure test suite aggregator demanding zero ambient authority.
//
// Beats:
//   1. Re-export core folding options, ANSI width calculations, and folding engine.
//   2. Re-export render text formatters, demo showcases, and JSON serializers.
//   3. Re-export IPC command-line argument parsers and MCP server loop.
//   4. Execute comprehensive multi-tier test suite across all subsystems.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

pub fn run_all_tests() -> Bool {
    let mut ok: Bool = true;
    ok = ok && run_core_tests();
    ok = ok && run_render_tests();
    ok = ok && run_ipc_tests();
    if ok {
        print("ALL oofold internal anchor tests PASSED\n");
    } else {
        print("SOME oofold internal anchor tests FAILED\n");
    }
    return ok;
}
