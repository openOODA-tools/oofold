// # Fold Engine - Line Wrapping and Width Folding
//
// Logline: Implements deterministic fixed-width folding across byte and column modes.
//
// Setup: Pure string transformation algorithm preserving ANSI sequences and word boundaries.
//
// Beats:
//   1. Segment input streams into newline-delimited line records.
//   2. Fold lines exceeding target width in byte or visual column mode.
//   3. Support space-break word boundary preservation (-s).
//   4. Collate folded lines into reconstructed output text.

import "core/fold_options.oo";
import "core/ansi_width.oo";

pub fn split_into_lines(text: String) -> List[String] {
    let mut lines: List[String] = list_new();
    let n: Int = chars_len(text);
    if n == 0 {
        return lines;
    }

    let mut start: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(text, i);
        if b == 10 { // newline \n
            let mut end: Int = i;
            if end > start && byte_at(text, end - 1) == 13 { // \r
                end = end - 1;
            }
            lines = list_push(lines, str_slice(text, start, end));
            start = i + 1;
        }
        i = i + 1;
    }
    if start < n {
        let mut end: Int = n;
        if end > start && byte_at(text, end - 1) == 13 {
            end = end - 1;
        }
        lines = list_push(lines, str_slice(text, start, end));
    }
    return lines;
}

fn fold_line_bytes(line: String, width: Int, space_break: Bool) -> List[String] {
    let mut out: List[String] = list_new();
    let n: Int = chars_len(line);
    if n <= width {
        out = list_push(out, line);
        return out;
    }

    let mut start: Int = 0;
    while start < n {
        let remaining: Int = n - start;
        if remaining <= width {
            out = list_push(out, str_slice(line, start, n));
            break;
        }

        let mut break_idx: Int = start + width;
        if space_break {
            let mut found_space: Int = -1;
            let mut j: Int = start + width;
            while j > start {
                let b: Int = byte_at(line, j - 1);
                if b == 32 || b == 9 {
                    found_space = j;
                    break;
                }
                j = j - 1;
            }
            if found_space > start {
                break_idx = found_space;
            }
        }

        out = list_push(out, str_slice(line, start, break_idx));
        start = break_idx;
        // In space break mode, skip leading space of subsequent line
        if space_break && start < n && (byte_at(line, start) == 32 || byte_at(line, start) == 9) {
            start = start + 1;
        }
    }
    return out;
}

fn fold_line_columns(line: String, width: Int, space_break: Bool) -> List[String] {
    let mut out: List[String] = list_new();
    let n: Int = chars_len(line);
    if calc_visual_width(line) <= width {
        out = list_push(out, line);
        return out;
    }

    let mut start_idx: Int = 0;
    while start_idx < n {
        let mut i: Int = start_idx;
        let mut col: Int = 0;
        let mut last_space_idx: Int = -1;

        while i < n && col < width {
            let b: Int = byte_at(line, i);
            if b == 27 {
                let esc_len: Int = get_ansi_sequence_len(line, i);
                if esc_len > 0 {
                    i = i + esc_len;
                    continue;
                }
            }

            if b == 32 || b == 9 {
                last_space_idx = i + 1; // Break after the space
            }

            if b == 9 {
                col = ((col / 8) + 1) * 8;
            } else if b == 8 {
                if col > 0 { col = col - 1; }
            } else if b >= 128 && b <= 191 {
                // Continuation byte adds 0 col
            } else {
                col = col + 1;
            }

            i = i + 1;
        }

        let mut cut_idx: Int = i;
        if space_break && last_space_idx > start_idx && cut_idx < n {
            cut_idx = last_space_idx;
        }

        if cut_idx == start_idx {
            cut_idx = cut_idx + 1; // Prevent zero-progress stall
        }

        out = list_push(out, str_slice(line, start_idx, cut_idx));
        start_idx = cut_idx;
        if space_break && start_idx < n && (byte_at(line, start_idx) == 32 || byte_at(line, start_idx) == 9) {
            start_idx = start_idx + 1;
        }
    }

    return out;
}

pub fn fold_single_line(line: String, cfg: FoldConfig) -> List[String] {
    if cfg.byte_mode {
        return fold_line_bytes(line, cfg.width, cfg.space_break);
    } else {
        return fold_line_columns(line, cfg.width, cfg.space_break);
    }
}

pub fn fold_text(text: String, cfg: FoldConfig) -> String {
    let lines: List[String] = split_into_lines(text);
    let num_lines: Int = list_len(lines);
    let mut out: String = "";

    let mut l_idx: Int = 0;
    while l_idx < num_lines {
        let line: String = list_get(lines, l_idx);
        let folded: List[String] = fold_single_line(line, cfg);
        let num_f: Int = list_len(folded);
        let mut f_idx: Int = 0;
        while f_idx < num_f {
            out = out + list_get(folded, f_idx) + "\n";
            f_idx = f_idx + 1;
        }
        l_idx = l_idx + 1;
    }
    return out;
}
